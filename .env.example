# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OSINT_ACCESS_SECRET: Optional server-side passcode secret used to unlock sensitive
# OSINT identity dossiers, unredacted badge/case logs, and dossier exports.
# Configure your own secret in Settings > Secrets; defaults to a demo passcode if unset.
OSINT_ACCESS_SECRET="MY_OSINT_ACCESS_SECRET"

# TRESTLE_API_KEY: Optional Trestle Reverse Phone API key for live subscriber owner
# names, current/historical street addresses, and linked contacts on personal & business lines.
TRESTLE_API_KEY=""

# TWILIO_ACCOUNT_SID & TWILIO_AUTH_TOKEN: Optional Twilio Lookup v2 credentials for
# live carrier CNAM caller name and LNP carrier/line-type resolution.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# GOOGLE_MAPS_API_KEY / VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key
# automatically provisioned via AI Studio Google Maps setup for Maps JavaScript API
# map rendering and server-side Geocoding REST API address resolution.
GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""

